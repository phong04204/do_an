        <mxCell id="User" value="&lt;div style=&quot;font-weight:bold;text-align:center;background-color:#fff2cc;padding:6px;&quot;&gt;User&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;&quot;&gt;- id: bigint&lt;br&gt;- name: string&lt;br&gt;- email: string&lt;br&gt;- password: string&lt;br&gt;- phone: string?&lt;br&gt;- role: enum(admin, seller, buyer)&lt;br&gt;- status: enum(active, banned)&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;&quot;&gt;+ isAdmin(): bool&lt;br&gt;+ isSeller(): bool&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#967f56;fontFamily=Times New Roman;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
